{
  "name": "algo-vision-app",
  "version": "1.0.0",
  "description": "Algo-Vision Desktop Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "clean-old-install": "powershell -ExecutionPolicy Bypass -File scripts/clean-old-install.ps1"
  },
  "keywords": [
    "electron",
    "desktop",
    "dashboard"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-reloader": "^1.2.3"
  },
  "dependencies": {
    "express": "^4.18.2",
    "overlayscrollbars": "^2.13.0",
    "vis-timeline": "^8.5.0"
  },
 "build": {
  "appId": "com.algovision.app",
  "productName": "Algo-Vision",
  "asar": true,
  "asarUnpack": [
    "node_modules/**/*"
  ],
  "directories": {
    "output": "dist"
  },
  "files": [
    "**/*",
    "!src/**/*",
    "!dist/**/*",
    "!.git/**/*"
  ],
  "win": {
    "target": "nsis",
    "icon": "assets/img/algo-logo.png",
    "signAndEditExecutable": false
  },
  "mac": {
    "target": "dmg",
    "icon": "assets/img/algo-logo.png"
  },
  "linux": {
    "target": "AppImage",
    "icon": "assets/img/algo-logo.png"
  }
}
}
